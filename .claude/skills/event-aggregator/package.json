{
  "name": "event-aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vienna event aggregator: scrape, store, rank, sync to calendar",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "ea": "node src/cli.ts",
    "scrape": "node src/cli.ts scrape",
    "digest": "node src/cli.ts digest",
    "rotate": "node src/cli.ts rotate",
    "merge": "node src/cli.ts merge",
    "stats": "node src/cli.ts stats",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
