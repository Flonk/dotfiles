default:
    @just --list

fmt:
    nix fmt

# Run the quickshell bar from the repo
qs-run:
    quickshell --path ./src/quickshell/shell

# Hot-reload the quickshell bar on QML changes
qs-dev:
    watchexec -r -w ./src/quickshell/shell -e qml,js,ts,css,json,yaml,yml -- quickshell --path ./src/quickshell/shell

# Run greeter in test mode
greet-dev:
    cd src/greeter && go run ./cmd/gloxwaldgreet --test --ascii ../../ascii.txt

# Preview GRUB theme in QEMU
grub-dev resolution="1920x1080":
    cd src/grub && bash preview.sh {{resolution}}

# Live-iterate the lockscreen shader: recompile on save; the preview window
# hot-swaps the shader in place (LockShaderPass watches the .qsb when SHADER_DEV=1).
# Keys 1-9 jump to that playlist mode, 0 returns to the normal sequence
shader-dev:
    #!/usr/bin/env bash
    set -euo pipefail
    just shader-build
    watchexec -w ./src/quickshell/lockscreen/shaders/scenes/yamp -w ./src/quickshell/lockscreen/qt_preamble.glsl -e glsl -- \
        just shader-build &
    trap 'kill $! 2>/dev/null' EXIT
    SHADER_DEV=1 quickshell --path ./src/quickshell/shell/preview.qml

# Preview the lockscreen shader in a floating window (no lock, no bar)
shader-preview:
    just shader-build
    quickshell --path ./src/quickshell/shell/preview.qml

# Build the lockscreen shader (.glsl → .frag.qsb)
shader-build:
    ./src/quickshell/lockscreen/convert-shaders.sh

# Clean compiled shaders
shader-clean:
    rm -rf ./src/quickshell/shell/shaders/
