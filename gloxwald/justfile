default:
    @just --list

fmt:
    nix fmt

# Run the quickshell bar from the repo
qs-run:
    quickshell --path ./src/quickshell/shell

# Hot-reload the quickshell bar on QML changes
qs-dev:
    watchexec -r -w ./src/quickshell/shell -e qml,js,ts,css,json,yaml,yml -- quickshell --path ./src/quickshell/shell

# Run greeter in test mode
greet-dev:
    cd src/greeter && go run ./cmd/gloxwaldgreet --test --ascii ../../ascii.txt

# Preview GRUB theme in QEMU
grub-dev resolution="1920x1080":
    cd src/grub && bash preview.sh {{resolution}}

# Live-iterate the lockscreen shader: recompile on save; the preview window
# hot-swaps the shader in place (LockShaderPass watches the .qsb when SHADER_DEV=1).
# Keys 1-9 jump to that playlist mode, 0 returns to the normal sequence
shader-dev:
    #!/usr/bin/env bash
    set -euo pipefail
    just shader-build
    watchexec -w ./src/quickshell/lockscreen/shaders/scenes/yamp -w ./src/quickshell/lockscreen/qt_preamble.glsl -e glsl,qml -- \
        just shader-build &
    trap 'kill $! 2>/dev/null' EXIT
    SHADER_DEV=1 quickshell --path ./src/quickshell/shell/preview.qml

# Preview the lockscreen shader in a floating window (no lock, no bar)
shader-preview:
    just shader-build
    quickshell --path ./src/quickshell/shell/preview.qml

# Build the lockscreen shader (.glsl → .frag.qsb)
shader-build:
    ./src/quickshell/lockscreen/convert-shaders.sh

# Bake the penrose label SDF atlas (shaders/assets/penrose_labels.png)
gen-sky:
    #!/usr/bin/env bash
    set -euo pipefail
    font=$(nix-build '<nixpkgs>' -A montserrat --no-out-link)/share/fonts/ttf/Montserrat-SemiBold.ttf
    emoji=$(nix-build '<nixpkgs>' -A noto-fonts-color-emoji --no-out-link)/share/fonts/noto/NotoColorEmoji.ttf
    data=$(mktemp -d)
    for f in stars.6.json constellations.lines.json constellations.json; do
        curl -sfL -o "$data/$f" "https://raw.githubusercontent.com/ofrohn/d3-celestial/master/data/$f"
    done
    cd ./src/quickshell/lockscreen/shaders/scenes/yamp
    nix-shell -p "python3.withPackages(p: [p.pillow p.numpy])" --run "python3 gen_sky.py $data $font $emoji"

# Bake the traffic scene's road maps from OpenStreetMap (shaders/assets/maps.png);
# name words (comma separated) to rebuild just the maps whose names hold them
gen-maps *only:
    #!/usr/bin/env bash
    set -euo pipefail
    font=$(nix-build '<nixpkgs>' -A montserrat --no-out-link)/share/fonts/ttf/Montserrat-SemiBold.ttf
    cd ./src/quickshell/lockscreen/shaders/scenes/yamp
    nix-shell -p "python3.withPackages(p: [p.pillow p.numpy p.scipy p.shapely])" --run "python3 gen_maps.py ${XDG_CACHE_HOME:-$HOME/.cache}/gloxwald-osm $font {{only}}"

gen-flapfont:
    #!/usr/bin/env bash
    set -euo pipefail
    font=$(nix-build '<nixpkgs>' -A montserrat --no-out-link)/share/fonts/ttf/Montserrat-SemiBold.ttf
    cd ./src/quickshell/lockscreen/shaders/scenes/yamp
    nix-shell -p "python3.withPackages(p: [p.pillow p.numpy p.scipy])" --run "python3 gen_flapfont.py $font"

gen-labels:
    #!/usr/bin/env bash
    set -euo pipefail
    rsfs=$(nix-build '<nixpkgs>' -A texlivePackages.rsfs --no-out-link)/fonts/type1/public/rsfs/rsfs10.pfb
    lmmath=$(nix-build '<nixpkgs>' -A lmmath --no-out-link)/share/fonts/opentype/latinmodern-math.otf
    cd ./src/quickshell/lockscreen/shaders/scenes/yamp
    nix-shell -p "python3.withPackages(p: [p.pillow p.numpy p.scipy])" --run "python3 gen_labels.py $rsfs $lmmath"

# Bake the scope beam path (shaders/assets/scope_path.png) from yamp_sdf.png
gen-scope:
    cd ./src/quickshell/lockscreen/shaders/scenes/yamp && nix-shell -p "python3.withPackages(p: [p.pillow p.numpy p.scikit-image])" --run "python3 gen_scope.py"

# Clean compiled shaders
shader-clean:
    rm -rf ./src/quickshell/shell/shaders/
