 }
 
+static gboolean req_is_open(struct pending_req *req, struct avdtp_stream *stream)
+{
+	return req && req->stream == stream && req->signal_id == AVDTP_OPEN;
+}
+
+gboolean avdtp_stream_open_pending(struct avdtp_stream *stream)
+{
+	struct avdtp *session = stream->session;
+	GSList *l;
+
+	if (session->pending_open == stream || req_is_open(session->req, stream))
+		return TRUE;
+
+	for (l = session->prio_queue; l; l = l->next)
+		if (req_is_open(l->data, stream))
+			return TRUE;
+
+	for (l = session->req_queue; l; l = l->next)
+		if (req_is_open(l->data, stream))
+			return TRUE;
+
+	return FALSE;
+}
